            local pc = p.Character
            local phum = pc and pc:FindFirstChildOfClass("Humanoid")
            local phrp = pc and pc:FindFirstChild("HumanoidRootPart")
            if phum and phum.Health > 0 and phrp then
                if not _kp_checkgun() then break end
                pcall(function() getgenv().TacoTeleport(phrp.CFrame) end)
                task.wait(0.05)
                local cur = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not cur then break end
                pcall(function()
                    cur.Anchored = true
                    local deadline = os.clock() + 2
                    local fired = 0
                    while os.clock() < deadline do
                        if not p.Parent or not pc.Parent or not phum.Parent or phum.Health <= 0 then break end
                        if _kp_KillGunMod(p, "Head", math.huge) then
                            fired = fired + 1
                        else
                            if not _kp_checkgun() then break end
                        end
                        task.wait(0.05)
                        if fired >= 3 and phum.Health <= 0 then break end
                    end
                end)
                pcall(function()
                    local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if h then h.Anchored = false end
                end)
                task.wait(0.05)
            end
        end
    end)
    pcall(function()
        local hf = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hf then hf.Anchored = wasAnchored; getgenv().TacoTeleport(original) end
    end)
end

