local function formatArrests(data)
    if type(data) ~= "table" then return "No data" end
    local lines = {}
    for i, rec in ipairs(data) do
        if type(rec) == "table" then
            local who   = rec.Player or rec.Name or rec.Username or rec[1] or "?"
            local cop   = rec.Officer or rec.Cop or rec.By or rec[2] or "?"
            local crime = rec.Crime or rec.Reason or rec[3] or "?"
            local time  = rec.Time or rec.When or rec[4] or ""
            table.insert(lines, string.format("%d) %s - by %s - %s %s", i, tostring(who), tostring(cop), tostring(crime), tostring(time)))
        else
            table.insert(lines, string.format("%d) %s", i, tostring(rec)))
        end
    end
    if #lines == 0 then return "No arrest records" end
    return table.concat(lines, "\n")
end

