local function _aimbotUpdateFOVVisual()
    if not _aimbotFOVCircle then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    if _aimbotCfg.Enabled and _aimbotCfg.ShowFOV then
        local vp = cam.ViewportSize
        local radius = (vp.Y / 2) * math.tan(math.rad(_aimbotCfg.FOV / 2))
        local center
        if _aimbotCfg.FOVMode == "Follow Mouse" then
            center = UserInputService:GetMouseLocation()
        else
            center = Vector2.new(vp.X / 2, vp.Y / 2)
        end
        _aimbotFOVCircle.Position = center
        _aimbotFOVCircle.Radius = radius
        _aimbotFOVCircle.Visible = true
        _aimbotFOVCircle2.Position = center
        _aimbotFOVCircle2.Radius = radius
        _aimbotFOVCircle2.Visible = true
    else
        _aimbotFOVCircle.Visible = false
        _aimbotFOVCircle2.Visible = false
    end
end

local function _aimbotActive()
    if not _aimbotCfg.Enabled then return false end
    if _aimbotCfg.UseAlwaysOn then return true end
    if _aimbotCfg.Key == Enum.UserInputType.MouseButton2 then
        return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    elseif _aimbotCfg.Key == Enum.UserInputType.MouseButton1 then
        return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
    else
        return UserInputService:IsKeyDown(_aimbotCfg.Key)
    end
end

local function _aimbotIsVisible(targetPart, targetChar)
    if not _aimbotCfg.VisibleCheck then return true end
    local cam = workspace.CurrentCamera
    if not cam or not targetPart then return true end
    local origin = cam.CFrame.Position
    local dest = targetPart.Position
    local dir = (dest - origin)
    local dist = dir.Magnitude
    if dist < 0.1 then return true end
    local filter = {}
    local myChar = LocalPlayer.Character
    if myChar then table.insert(filter, myChar) end
    if targetChar then table.insert(filter, targetChar) end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = filter
    params.IgnoreWater = true
    local result = workspace:Raycast(origin, dir, params)
    if not result then return true end
    if result.Instance == targetPart then return true end
    if targetChar and result.Instance:IsDescendantOf(targetChar) then return true end
    return false
end

local function _aimbotFindTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local vp = cam.ViewportSize
    local radius = (vp.Y / 2) * math.tan(math.rad(_aimbotCfg.FOV / 2))
    local center
    if _aimbotCfg.FOVMode == "Follow Mouse" then
        center = UserInputService:GetMouseLocation()
    else
        center = Vector2.new(vp.X / 2, vp.Y / 2)
    end
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local c = p.Character
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local partName = _aimbotCfg.HitPart
                if partName == "Torso" then partName = "UpperTorso" end
                local targetPart = nil
                if _aimbotCfg.HitPart == "Closest" then
                    local bestLocal = nil
                    local bestLocalDist = math.huge
                    for _, name in ipairs({"Head","UpperTorso","HumanoidRootPart"}) do
                        local pt = c:FindFirstChild(name)
                        if pt then
                            local sp, on = cam:WorldToViewportPoint(pt.Position)
                            if on and sp.Z > 0 then
                                local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                                if d < bestLocalDist then
                                    bestLocalDist = d
                                    bestLocal = pt
                                end
                            end
                        end
                    end
                    targetPart = bestLocal
                else
                    targetPart = c:FindFirstChild(partName or "Head") or c:FindFirstChild("HumanoidRootPart")
                end
                if targetPart then
                    local sp, on = cam:WorldToViewportPoint(targetPart.Position)
                    if on and sp.Z > 0 then
                        local screenPos = Vector2.new(sp.X, sp.Y)
                        local d = (screenPos - center).Magnitude
                        if d <= radius and d < bestDist then
                            if _aimbotIsVisible(targetPart, c) then
                                bestDist = d
                                best = { player = p, part = targetPart }
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function _aimbotStop()
    if _aimbotConn then pcall(function() _aimbotConn:Disconnect() end); _aimbotConn = nil end
    if _aimbotFOVCircle then _aimbotFOVCircle.Visible = false end
    if _aimbotFOVCircle2 then _aimbotFOVCircle2.Visible = false end
end

local function _aimbotStart()
    _aimbotStop()
    _aimbotInitFOV()
    _aimbotConn = RunService.RenderStepped:Connect(function(dt)
        _aimbotUpdateFOVVisual()
        if not _aimbotCfg.Enabled then return end
        if not _aimbotActive() then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local tgt = _aimbotFindTarget()
        if not tgt or not tgt.part or not tgt.part.Parent then return end
        local desired = CFrame.new(cam.CFrame.Position, tgt.part.Position)
        if _aimbotCfg.Smooth <= 0 then
            cam.CFrame = desired
        else
            local alpha = math.clamp(dt / math.max(_aimbotCfg.Smooth, 0.01), 0, 1)
            cam.CFrame = cam.CFrame:Lerp(desired, alpha)
        end
    end)
end

