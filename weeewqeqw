        local v = rawget(cfg, k)
        saved.exists[k] = v ~= nil
        saved.values[k] = v
    end
    _bulletVisualOriginals[cfg] = saved
end
local function _restoreBulletVisualConfig(cfg)
    local saved = _bulletVisualOriginals[cfg]
    if not saved then return end
    for _, k in ipairs(_bulletVisualKeys) do
        rawset(cfg, k, saved.exists[k] and saved.values[k] or nil)
    end
end
local function _collectBulletVisualConfigs()
    local ok, objects = pcall(getgc, true)
    if not ok or type(objects) ~= "table" then return end
    local function add(c)
        if typeof(c) == "table" and rawget(c, "BulletSpeed") then
            _bulletVisualConfigs[c] = true
            _saveBulletVisualOriginals(c)
        end
    end
    for _, o in ipairs(objects) do
        if typeof(o) == "table" then
            pcall(function() add(o); add(rawget(o, 7)); add(rawget(o, 8)) end)
        end
    end
    _bulletVisualLastScan = os.clock()
end
